{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "simo-robot-tools",
  "version": "1.0.0",
  "description": "Simo 智能小车工具集 - 供 miniClaw 或其他 AI 助手使用",
  
  "tools": [
    {
      "name": "simo_move",
      "description": "控制 Simo 小车移动。前进/后退指定时长。遵循安全原则：如有障碍物会被阻止。",
      "parameters": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "enum": ["F", "B"],
            "description": "移动方向：F=前进，B=后退"
          },
          "duration_ms": {
            "type": "integer",
            "enum": [400, 800, 1200],
            "default": 800,
            "description": "移动时长（毫秒）：400=短，800=中，1200=长"
          }
        },
        "required": ["direction"]
      },
      "http": {
        "method": "POST",
        "url": "http://localhost:3001/api/intent/execute",
        "headers": {
          "Content-Type": "application/json",
          "X-Simo-Token": "${SIMO_TOOL_TOKEN}"
        },
        "body": {
          "intent": "MOVE",
          "direction": "${direction}",
          "duration_ms": "${duration_ms}",
          "source": "miniclaw"
        }
      }
    },
    {
      "name": "simo_turn",
      "description": "控制 Simo 小车转向。左转/右转指定时长。",
      "parameters": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "enum": ["L", "R"],
            "description": "转向方向：L=左转，R=右转"
          },
          "duration_ms": {
            "type": "integer",
            "enum": [400, 800, 1200],
            "default": 800,
            "description": "转向时长（毫秒）"
          }
        },
        "required": ["direction"]
      },
      "http": {
        "method": "POST",
        "url": "http://localhost:3001/api/intent/execute",
        "headers": {
          "Content-Type": "application/json",
          "X-Simo-Token": "${SIMO_TOOL_TOKEN}"
        },
        "body": {
          "intent": "TURN",
          "direction": "${direction}",
          "duration_ms": "${duration_ms}",
          "source": "miniclaw"
        }
      }
    },
    {
      "name": "simo_stop",
      "description": "紧急停止 Simo 小车。此命令永远可用，无需鉴权，会立即中断所有动作。",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "http": {
        "method": "POST",
        "url": "http://localhost:3001/api/intent/stop",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    {
      "name": "simo_status",
      "description": "获取 Simo 小车当前状态，包括：运动状态、传感器数据、安全状态、硬件连接状态。只读接口，无需鉴权。",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "http": {
        "method": "GET",
        "url": "http://localhost:3001/api/state"
      }
    },
    {
      "name": "simo_sensors",
      "description": "获取 Simo 小车传感器数据：超声波距离、红外避障状态等。只读接口。",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "http": {
        "method": "GET",
        "url": "http://localhost:3001/api/hardware/sensors"
      }
    },
    {
      "name": "simo_hardware",
      "description": "获取 Simo 硬件能力和连接状态。用于了解当前可用的功能。只读接口。",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "http": {
        "method": "GET",
        "url": "http://localhost:3001/api/hardware/status"
      }
    },
    {
      "name": "simo_autonomy",
      "description": "控制 Simo 自主避障模式。开启后小车会自动避开障碍物。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["start", "stop", "status"],
            "description": "操作类型：start=启动，stop=停止，status=查询状态"
          }
        },
        "required": ["action"]
      },
      "http": {
        "method": "POST",
        "url": "http://localhost:3001/api/autonomy/${action}",
        "headers": {
          "Content-Type": "application/json",
          "X-Simo-Token": "${SIMO_TOOL_TOKEN}"
        }
      }
    },
    {
      "name": "simo_navigation",
      "description": "控制 Simo 导航模式：巡逻、跟随、返航。",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["patrol", "follow", "return", "stop"],
            "description": "导航模式：patrol=巡逻，follow=跟随，return=返航，stop=停止导航"
          }
        },
        "required": ["mode"]
      },
      "http": {
        "method": "POST",
        "url": "http://localhost:3001/api/nav/${mode}",
        "headers": {
          "Content-Type": "application/json",
          "X-Simo-Token": "${SIMO_TOOL_TOKEN}"
        }
      }
    }
  ],
  
  "safety_principles": {
    "description": "所有工具调用都遵循 Simo 的行为宣言（BEHAVIOR.md）",
    "rules": [
      "AI 没有执行权：所有动作都经过 Intent → Guard → Confirm → Execute 链路",
      "STOP 永远最高优先级：任何时候都可以中断",
      "安全优先：传感器检测到障碍物时自动阻止危险动作",
      "时长限制：单次移动最大 1200ms，防止失控",
      "速率限制：每秒最多 2 次写操作，防止滥用"
    ]
  },
  
  "configuration": {
    "base_url": "http://localhost:3001",
    "token_env": "SIMO_TOOL_TOKEN",
    "timeout_ms": 5000
  }
}
